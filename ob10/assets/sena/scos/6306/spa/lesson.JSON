]}, {"type": "target_word", "contents": [{"content": "rumbling", "type": "name"}, {"content": "to make a deep, low sound", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  My stomach is rumbling. Let's get dinner! ", "type": "example"}, {"content": "engenn8le13ob10aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Watch the movie <span class=\"italic\">The Notebook</span> with a friend.", "type": "text"}, {"content": "Ask your friend negative questions to find out if they liked the movie. (e.g. <span class=\"italic\">Wasn't it good love story?</span> or <span class=\"italic\">Didn't you think it was long?</span>)", "type": "text"}, {"content": " Write a 150-word review of the movie.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I listen to and watch a movie.", "type": "text"}, {"content": "I use the Simple Past tense to retell the story.", "type": "text"}, {"content": "I use negative questions to gain confirmation on what a friend thought about the movie.", "type": "text"}, {"content": "I write a review using the Simple Present and Simple Past tenses.", "type": "text"}]}], "labs": [{"exercises": [{"questions": [], "_data": [{"type": "instructions", "contents": [{"content": " I can talk about feelings and reactions. ", "type": "Learning Outcomes"}, {"content": " I can encourage agreement.", "type": "Learning Outcomes"}, {"content": " I can talk about things that happen or things that happened.", "type": "Learning Outcomes"}, {"content": " Do you believe in love at first sight? Explain.", "type": "Free Header Item"}, {"content": " Describe your idea of a good date and a bad date.", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "a