{"_data": [{"contents": [{"content": "The Secret Valentine", "type": "lesson_name"}, {"content": "White Night", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.3", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn8le13ob07re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Negative questions to encourage agreement", "type": "heading"}, {"content": "Negative questions are used for confirmation or agreement. They can be used with any verb tense.", "type": "describer"}, {"content": " Negative questions can be used with any verb tense but the forms must be correctly used. <br /><br /> Negative auxiliary + subject + main verb  <br /><br /> <span class=\"italic\">Wouldn't you love to watch the sun rise?</span> <br /><br /> Remember that questions with the verb to be in the  simple present and past are formed differently. <br /><br /> Be verb + subject<br /><br/> Wasn't <span class=\"italic\">tonight indescribably amazing?</span> <br /> Isn't <span class=\"italic\">tonight indescribably amazing?</span>", "type": "text"}, {"content": "Don't you feel a little sick?", "type": "example"}, {"content": "Didn't I have two?  ", "type": "example"}, {"content": "Don't you think we should come for the playoffs if the Celtics make it this year?", "type": "example"}, {"content": " Aren't you ready to go back to your hotel?", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Modals for suggestions, necessity, and possibility", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "<span class=\"strong\">Modals of possibility</span><br /> <span class=\"italic\">Might</span> and <span class=\"italic\">may</span> are both modals used to talk about possibilities.<br /> <span class=\"italic\">Might</span> is more common than <span class=\"italic\">may </span>in conversation. <span class=\"italic\">May </span>sounds more formal than <span class=\"italic\">might</span>.<br /> <br /><span class=\"italic\"> We might have to come up for more games.<br /></span>  <span class=\"italic\">You might want to sleep in before you check out tomorrow.</span> <br /><br />  You can also use the modal<span class=\"italic\"> could</span> to talk about possibilities. <br /><br /> <span class=\"italic\">We could come up for more games ...<br /></span> <span class=\"italic\">You could sleep in.</span>", "type": "text"}, {"content": "Basketball could be my new favorite sport.", "type": "example"}, {"content": "And Steve might be my new favorite person! ", "type": "example"}, {"content": "Hey we should get seasons tickets!", "type": "example"}, {"content": "You shouldn't either. ", "type": "example"}, {"content": "I could stay up all night.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "indescribably ", "type": "name"}, {"content": "in a way that is impossible to describe", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Wasn't tonight indescribably amazing?", "type": "example"}, {"content": "engenn8le13ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when talking about a game.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "pint ", "type": "name"}, {"content": "a large glass of beer; approximately half a liter", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You had only one pint!", "type": "example"}, {"content": "engenn8le13ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "cheering ", "type": "name"}, {"content": "shouts of encouragement", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I loved all the cheering. ", "type": "example"}, {"content": "engenn8le13ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "jersey ", "type": "name"}, {"content": " a knitted shirt or sweater", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Everyone had a jersey or painted their face.", "type": "example"}, {"content": "engenn8le13ob07aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to make it ", "type": "name"}, {"content": "to succeed in something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: The Celtics might make it this year.", "type": "example"}, {"content": "engenn8le13ob07aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to be game", "type": "name"}, {"content": "to participate in an activity risking something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm game!", "type": "example"}, {"content": "engenn8le13ob07aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to sleep in", "type": "name"}, {"content": "to get up late", "type": "definition"}, {"content": " (verb)", "type": "part_speech"}, {"content": "Example: You might want to sleep in before you check out tomorrow.", "type": "example"}, {"content": "engenn8le13ob07aud07", "type": "audio"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"content": "Write a letter to a friend and tell him/her about a fun evening you had.", "type": "text"}, {"content": "Say who you went with, where you went.", "type": "text"}, {"content": "Explain what might have made the evening so special", "type": "text"}, {"content": "Ask him/her to tell you about a night he/she enjoyed", "type": "text"}, {"content": "Read your letter aloud to another student.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write  letter about a wonderful evening.", "type": "text"}, {"content": "I say who I went with and where I went.", "type": "text"}, {"content": "I explain what might have made the night so wonderful.", "type": "text"}, {"content": "I share my letter with a partner.", "type": "text"}]}], "labs": [{"exercises": [{"questions": [], "temp