t"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "id": 11}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "type": "welcome", "id": 0}, {"id": 1, "template_override": 1, "title": "", "_data": [], "type": "audio", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le13ob07re2img05.jpg", "audiosrc": "engenn8le13ob07re2aud01", "images": [{"time": "0", "image": "engenn8le13ob07re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le13ob07re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter:</span> Wasn't tonight indescribably amazing?\n<br /><span class=\"strong\">Vanessa:</span> Absolutely! Basketball could be my new favorite sport.\n<br /><span class=\"strong\">Sally:</span> And Steve might be my new favorite person!\n<br /><span class=\"strong\">Peter:</span> The best part is that the Celtics won! Hey, we should get season's tickets!\n<br /><span class=\"strong\">Vanessa:</span> I've never eaten so much popcorn and drunk so much beer at a game! Don't you feel a little sick?"}, {"time": "28500", "image": "engenn8le13ob07re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Peter:</span> No! You shouldn't either. You had only one pint!\n<br /><span class=\"strong\">Vanessa:</span> Didn't I have two?  The crowd was fun. I loved all the cheering and the players were so tall and talented. It was an all-American experience. I loved that everyone had a jersey or painted their face to root for their team.\n<br /><span class=\"strong\">Peter:</span> Don't you think we should come for the playoffs if the Celtics make it this year?\n<br /><span class=\"strong\">Vanessa:</span> I'm game! Sally, your new man enjoyed it too. We might have to come up for more games ...  but we can't make such a late night of it next time. I am supposed to be back at the restaurant at 6 pm."}, {"time": "66500", "image": "engenn8le13ob07re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally:</span> Wouldn't you love to watch the sun rise?\n<br /><span class=\"strong\">Peter:</span>  Aren't you ready to go back to your hotel? It's four in the morning! You might want to sleep in before you check out tomorrow.\n<br /><span class=\"strong\">Sally:</span> I could stay up all night.\n<br /><span class=\"strong\">Vanessa:</span> Somebody is falling in love!"}]}}]}]}], "type": "sena"}