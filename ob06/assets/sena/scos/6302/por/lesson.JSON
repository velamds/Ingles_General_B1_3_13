t": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "id": 10}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn8le13ob06re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " \nTalk about traditional music.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "type": "DWS", "id": 11}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "template_override": 1, "title": "", "_data": [], "type": "audio", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le13ob06re2img05.jpg", "audiosrc": "engenn8le13ob06re2aud01", "images": [{"time": "0", "image": "engenn8le13ob06re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le13ob06re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally:</span> Vanessa, what are you doing for Valentine's day?\n<br /><span class=\"strong\">Vanessa:</span> Things will be hectic at the restaurant, so I'll be there. Why? Are we supposed to do something?\n<br /><span class=\"strong\">Sally:</span> No, I'm supposed to have a date with someone I met recently at a coffee shop. His name is Steve.\n<br /><span class=\"strong\">Vanessa:</span> You have to tell me more. Are you supposed to be spending Valentine's day with him?\n<br /><span class=\"strong\">Sally:</span> I think so, but first I need some advice. I want to take things slow. Tell me what you think, should I let him hold hands with me?"}, {"time": "27500", "image": "engenn8le13ob06re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa:</span> If you aren't comfortable with it, you shouldn't do it.\n<br /><span class=\"strong\">Sally:</span> Yeah I'm not into showing affection publicly yet.\n<br /><span class=\"strong\">Vanessa:</span> You ought to be direct and tell him you need to take it really slow.\n<br /><span class=\"strong\">Sally:</span> That's true. I want to know about his last relationship and more about his values."}, {"time": "44500", "image": "engenn8le13ob06re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa:</span> You could tell him a bit about your own and maybe he will reveal more. You have to give him time to open up to you. Can you tell me what he's like?\n<br /><span class=\"strong\">Sally:</span>  He's soft-spoken and polite. He's a musician who plays violin, harmonica and slide guitar in a bluegrass band. He is supposed to play this Saturday.\n<br /><span class=\"strong\">Vanessa:</span> Isn't that a real old style of American music? It's supposed to be fun to listen to. Maybe you could take me to a show at some point.\n<br /><span class=\"strong\">Sally:</span> I am supposed to see his band this Saturday. We could go together.\n<br /><span class=\"strong\">Vanessa:</span> Only if you think it's a good idea. It might be a lot of fun. I'd love to hear some traditional American numbers!"}]}}]}], "id": 0}], "_data": [{"contents": [{"content": "The Secret Valentine", "type": "lesson_name"}, {"content": "Be My Valentine", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.3", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe events through a wider range of B1 language in both work and social contexts", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn8le13ob06re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " Modals for suggestions, necessity, and possibility", "type": "heading"}, {"content": "Modals are auxiliary verbs used to make suggestions,express necessity or show possibility. In the simple present, you need a modal plus the base form of the main verb.", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">  Type of Modal </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">  Example </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Modals of Suggestion </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> If you aren't comfortable with it, you <span class=\\\"strong\\\">shouldn't</span> do it. <br /><br /> You <span class=\\\"strong\\\">could</span> tell him a bit about your own and maybe he will reveal more.  <br /><br /> You <span class=\\\"strong\\\">ought to</span> be direct and tell him you need to take it really slow. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Modals of Necessity </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">  You <span class=\\\"strong\\\">have to</span> give him time to open up to you.   </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">  Modals of Possibility  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> It <span class=\\\"strong\\\">might </span>be a lot of fun.  </span>\\\"}\"],\"styles\":\"\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "To Be Supposed To", "type": "heading"}, {"content": "You use the structure <span class=\"strong\">be supposed </span>to when you want to talk about expectations, obligations or arrangements.", "type": "describer"}, {"content": "You can use <span class=\"strong\">be supposed to</span> to talk about situations in the past, present or future. <br /><br /> The structure is: <br /><br /> Subject + To be + supposed to + verb <br /><br />  <span class=\"italic\">I'm supposed to have a date with someone I met recently at a coffee shop.  </span><br /><br /> **Pronunciation tip**:<br /> When you say be supposed to, you link the /d/ and /t/ sounds together.  <br /><br /> Like this:<br /> Be suppose_to <br /><br /> Note: To use suppose to in the past put the be verb in the past tense: <br /><br /> Subject + Was/Were + supposed to + Verb <br /><br /> <span class=\"italic\">I <span class=\"underline\">was</span> supposed to have a date with someone I met recently.</span>", "type": "text"}, {"content": "I'm supposed to have a date with someone I met recently at a coffee shop.", "type": "example"}, {"content": "Are you supposed to be spending Valentine's day with him?", "type": "example"}, {"content": "He is supposed to play this Saturday.", "type": "example"}, {"content": "It's supposed to be fun to listen to.", "type": "example"}, {"content": "I am supposed to see his band this Saturday.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "to take things slow", "type": "name"}, {"content": "to take time getting to know the person you are dating", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I want to take things slow.", "type": "example"}, {"content": "engenn8le13ob06aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when talking about a new relationship or music.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to show affection", "type": "name"}, {"content": "to physically display expressions of affection.", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm not into showing affection publicly just yet.", "type": "example"}, {"content": "engenn8le13ob06aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to be direct", "type": "name"}, {"content": " to be clear about something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You ought to be direct and tell him you need to take it really slow.", "type": "example"}, {"content": "engenn8le13ob06aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "value", "type": "name"}, {"content": " a principle of behavior ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to know more about his values.", "type": "example"}, {"content": "engenn8le13ob06aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "harmonica", "type": "name"}, {"content": "a wind  musical instrument with reeds", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He's a musician who plays harmonica. ", "type": "example"}, {"content": "engenn8le13ob06aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "slide guitar ", "type": "name"}, {"content": "a blues guitar playing style in which a deviceis used to slide on the guitar neck", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: He plays the slide guitar.", "type": "example"}, {"content": "engenn8le13ob06aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "bluegrass", "type": "name"}, {"content": "a kind of country music very popular in the south of the United States", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He plays in a bluegrass band. ", "type": "example"}, {"content": "engenn8le13ob06aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "at some point ", "type": "name"}, {"content": "at a moment that is not specified", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You could take me to a show at some point.", "type": "example"}, {"content": "engenn8le13ob06aud08", "type": "audio"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"content": "Tell someone not from your country about the traditional music in your country and why you like it.", "type": "text"}, {"content": "Find the names of all the instruments (online) that are used to make traditional music.", "type": "text"}, {"content": "Explain to a your foreign visitor why they might want to go with you  to hear some traditional music.", "type": "text"}, {"content": "Write a note inviting them  to go to listen to traditional music", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about traditional music in my country.", "type": "text"}, {"content": "I write making suggestions about where to see traditional music.", "type": "text"}, {"content": "I explain why someone might enjoy the traditional music.", "type": "text"}, {"content": "I write a note inviting someone to go to hear traditional music.", "type": "text"}]}], "type": "sena"}