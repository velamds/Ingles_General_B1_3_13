t": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le13ob08re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nLet's explore different kinds of poetry.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le13ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Hey, what's that?\n<br /><span class=\"strong\">Sally</span>: I'm not sure.  It's a letter of some kind.\n<br /><span class=\"strong\">Vanessa</span>: Does the address look familiar? It might be from a long-lost relative.\n<br /><span class=\"strong\">Sally</span>: Oh my goodness!\n<br /><span class=\"strong\">Vanessa</span>: Calm down and let me see. Someone has written you a poem? Well ... that's different!\n<br /><span class=\"strong\">Sally</span>: Wow ... This is from Christian from work.  I think it's a Valentine's Day poem.\n<br /><span class=\"strong\">Vanessa</span>: He wrote you a poem?\n<br /><span class=\"strong\">Sally</span>: This is the sweetest thing I have ever read. It even rhymes. It's long too - 3 stanzas.  This must have taken him ages. You could read it aloud for me.", "id": 1, "time": "100", "image": "engenn8le13ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: <br />My Valentine, you're all I see;<br />\nIn you, I find joy and delight;<br />\nYou make me all I can be;<br />\nI'm happiest when I'm in your light.<br /><br />I dream of you both night and day;<br />\nI'm drawn to you like the sun;<br />\nWhen you're not here, my heart feels pain;<br />\nYou are the only one.<br /><br />I think of love like this, and smile;<br />\nI never thought that I could obtain;<br />\nThe deep, excitement in my soul;<br />\nIs something I can never explain.", "id": 2, "time": "39000", "image": "engenn8le13ob08re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>: How romantic! It's a shame that I'm not interested in him.\n<br /><span class=\"strong\">Vanessa</span>: Sally, who is this guy? Granted he is a bit of a wordsmith but how well do you really know him? Does he have a bit of an obsession?\n<br /><span class=\"strong\">Sally</span>: He might work in the accountant's department.  I don't see him very often and when I do, he's quite shy.\n<br /><span class=\"strong\">Vanessa</span>: It sounds like he has a crush on you.  You may want to talk to him.\n<br /><span class=\"strong\">Sally</span>: Should I call him or do you think it's better if I speak to him face to face?\n<br /><span class=\"strong\">Vanessa</span>: I think you have to consider his feelings. You should let him down gently when you see him tomorrow.\n<br /><span class=\"strong\">Sally</span>: I promise I won't crack up.  That would be very unkind.", "id": 3, "time": "75000", "image": "engenn8le13ob08re2img02.jpg"}], "audiosrc": "engenn8le13ob08re2aud01", "coverimg": "engenn8le13ob08re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "Poetry", "id": 1, "time": "5000", "image": ""}, {"text": "<span class = \"bullet\">What is poetry?</span>", "id": 2, "time": "6000", "image": ""}, {"text": "<span class = \"bullet\">Different types of poetry</span>", "id": 3, "time": "35000", "image": ""}, {"text": "<span class = \"bullet\">Understanding a poem</span>", "id": 4, "time": "98000", "image": ""}], "video_src": "engenn8le13ob08vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}]}]}