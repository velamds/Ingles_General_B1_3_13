d": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " \nWrite a dialogue about getting tickets for a game.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}], "type": "post_instructions"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le13ob04re2aud01", "images": [{"time": "0", "text": "", "id": 0, "image": "engenn8le13ob04re2img01.jpg"}, {"time": "100", "text": "<span class=\"strong\">Vanessa</span>: I can't wait to go to Boston! The shopping will be impressive and we get to see a live basketball game. What's the team called?\n<br /><span class=\"strong\">Sally</span>: The Boston Celtics. Don't they wear bright green, not dark green?\n<br /><span class=\"strong\">Vanessa</span>: I don't know! I've never been to a basketball game. Is it important to wear the colors?\n<br /><span class=\"strong\">Sally</span>: Yes. It's traditional to show team spirit, don't you think? Peter probably has a team jersey and we can paint green clovers on our faces. He'll be impressed if we do that.\n<br /><span class=\"strong\">Vanessa</span>: Why clovers?", "id": 1, "image": "engenn8le13ob04re2img01.jpg"}, {"time": "32300", "text": "<span class=\"strong\">Sally</span>: It's the team logo.\n<br /><span class=\"strong\">Vanessa</span>: This is going to be a different experience! Doesn't everyone stand up at the beginning of the game to sing the national anthem?\n<br /><span class=\"strong\">Sally</span>: Of course!\n<br /><span class=\"strong\">Vanessa</span>: Doesn't it make sense to wear comfortable sneakers?\n<br /><span class=\"strong\">Sally</span>: Yup. It's impossible to stay seated ... and stay quiet!", "id": 2, "image": "engenn8le13ob04re2img02.jpg"}, {"time": "50000", "text": "<span class=\"strong\">Vanessa</span>: I don't know if I'll understand the rules immediately. Won't you and Peter explain where the boundaries are and what the rules are?\n<br /><span class=\"strong\">Sally</span>: We'll explain, but generally the rules become clear as the game unfolds. Peter is going to be immensely happy that we got tickets to Wednesday's game! Aren't you excited?\n<br /><span class=\"strong\">Vanessa</span>: Yes, this will be a new cultural event for me!\n<br /><span class=\"strong\">Sally</span>: Basketball is definitely one of our national sports. This is going to be lots of fun!", "id": 3, "image": "engenn8le13ob04re2img05.jpg"}], "coverimg": "engenn8le13ob04re2img01.jpg"}}], "template_override": 1, "type": "audio", "id": 1, "_data": [], "title": ""}]}]}