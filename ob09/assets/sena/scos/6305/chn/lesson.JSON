 {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "id": 10}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn8le13ob09re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "\nResearch a Love Affair.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le13ob09re2img05.jpg", "audiosrc": "engenn8le13ob09re2aud01", "images": [{"time": "0", "image": "engenn8le13ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le13ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa:</span> You must be over the moon, Sally!\n<br /><span class=\"strong\">Sally:</span> I am, but I want to stay grounded! Last night, Steve said he freed up some time to meet my family.\n<br /><span class=\"strong\">Vanessa:</span> No way! Already? You said you didn't want to move too fast.\n<br /><span class=\"strong\">Sally:</span> Sometimes things just gain momentum. We really like each other and he has a sense of humor that always cheers me up."}, {"time": "21000", "image": "engenn8le13ob09re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa:</span> I understand. You must be very happy. Do you think you are falling in love?\n<br /><span class=\"strong\">Sally:</span> We meet for coffee some mornings and after we visited Boston for the game, something just clicked, but I am trying not to rush into it.I don't want it all to run away with me.\n<br /><span class=\"strong\">Vanessa:</span> Good for you! You sound very level-headed. You must be feeling very proud of yourself, but I can tell you are a bit anxious.\n<br /><span class=\"strong\">Sally:</span> I just need to not take it so seriously.  It hasn't turned into anything yet. I have to keep in touch with all my friends so I don't inadvertently fall out with them. You must be tired of hearing about it. What about you? Are you interested in anyone?"}, {"time": "60200", "image": "engenn8le13ob09re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa:</span> No, but I received a box of chocolates and a rose from a regular customer.\n<br /><span class=\"strong\">Sally:</span> He must really care for you.\n<br /><span class=\"strong\">Vanessa:</span> I suppose.  It was kind, but I don't not really like red roses. I prefer lilies or peonies. Anyway, he isn't my type.\n<br /><span class=\"strong\">Sally:</span> Yes, but red roses are a symbol of true love."}]}}], "id": 1}], "id": 0}], "_data": [{"contents": [{"content": "The Secret Valentine", "type": "lesson_name"}, {"content": "Symbols of Love", "type"