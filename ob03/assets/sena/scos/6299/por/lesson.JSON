type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": "Plan a Costume Party!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le13ob03re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"_data": [], "type": "audio", "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn8le13ob03re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Sally:</span> We're having a 1970s party for my Dad. I need an outfit!\n<br /><span class=\"strong\">Vanessa:</span>   You must be so pumped ! You can wear funky clothes and listen to psychedelic music. Didn't people wear bell bottoms back then?\n<br /><span class=\"strong\">Sally:</span>  They had platform shoes, wide lapels and everything was polyester!\n<br /><span class=\"strong\">Vanessa:</span> That's kind of gross, don't you think?\n<br /><span class=\"strong\">Sally:</span> I can dig it! I want to breeze into the party wearing funky patterns.\n<br /><span class=\"strong\">Vanessa:</span> And you can dance disco! I fell in love with it when I heard it.", "image": "engenn8le13ob03re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally:</span> Mom is organizing everything to be authentically seventies. She's even seen about getting some seventies car!\n<br /><span class=\"strong\">Vanessa:</span> Awesome! Wouldn't it be fun to drive around in one of those?\nYour Mom must be thoroughly enjoying the planning of this party!\n<br /><span class=\"strong\">Sally:</span> She must be feeling nostalgic.\n<br /><span class=\"strong\">Vanessa:</span> Wasn't that huge outdoor concert in the seventies?\n<br /><span class=\"strong\">Sally:</span> Yeah. Woodstock. They must be disappointed in the way society has turned out.", "image": "engenn8le13ob03re2img05.jpg", "time": "30000", "id": 2}, {"text": "<span class=\"strong\">Vanessa:</span> What about your outfit? Aren't we supposed to figure that out now?\n<br /><span class=\"strong\">Sally:</span> We know what we want: Bell bottoms, a wide lapel shirt that's funky!\n<br /><span class=\"strong\">Vanessa:</span> You must be happy that you've figured out the perfect outfit!\n<br /><span class=\"strong\">Sally:</span> That came about easily! Now we'd better think of one for you. You're invited too.\n<br /><span class=\"strong\">Vanessa:</span> Excellent! You can count on me to be there.", "image": "engenn8le13ob03re2img02.jpg", "time": "57000", "id": 3}], "coverimg": "engenn8le13ob03re2img05.jpg", "audiosrc": "engenn8le13ob03re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "The Secret Valentine", "type": "lesson_name"}, {"content": "The Right Outfit", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "  Describe events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}]}, {"content": "engenn8le13ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Inseparable Phrasal Verbs", "type": "heading"}, {"content": "Phrasal verbs are two-part verbs consisting of a verb followed by an adverb particle (these look like prepositions, but do not have the same function in phrasal verbs). <br />In some cases, it is not possible to separate the verb and the particle. These are called <span class=\"italic\">inseparable</span> phrasal verbs.", "type": "describer"}, {"content": "Remember that the meaning of a phrasal verb is often very different from the two parts taken separately. <br /><br /> For example: <br /> <span class=\"italic\">Breeze into </span>has a figurative meaning.<br /> A breeze is a wind, so it is a noun. When you add the particle <span class=\"italic\">into</span>,  <span class=\"italic\">breeze into</span> means walk into a place easily and confidently like a breeze. <br /><br /> <span class=\"italic\">See about </span>does not literally mean to use your eyes, but investigate or gather information. <br /><br /> Learning phrasal verbs is a lot like learning new vocabulary. You must memorize which phrasal verbs are inseparable and learn their meanings. ", "type": "text"}, {"content": "I want to <span class=\"strong\">breeze into </span>the party wearing funky patterns.", "type": "example"}, {"content": "They must be disappointed in the way society has <span class=\"strong\">turned out</span>.", "type": "example"}, {"content": "Mom's even <span class=\"strong\">seen about</span> getting some seventies cars.", "type": "example"}, {"content": "That <span class=\"strong\">came about</span> easily!", "type": "example"}, {"content": "They must be <span class=\"strong\">let down</span> by the way society has <span class=\"strong\">turned out</span>.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Negative Questions to Encourage Agreement", "type": "heading"}, {"content": "You use negative questions to confirm information you already know.", "type": "describer"}, {"content": "You can ask a negative question for confirmation. <br /><br/>Example: <br> <span class=\"italic\">Wouldn't it be fun to drive around in one of those cars? (I expect you to say yes.)</span> <br />This is how negative questions with <span class=\"underline\">regular verbs</span> in Simple Present and Simple Past are formed: <br /><br /> negative auxiliary + subject + main verb (base form)  <br /><br /> Negative questions with regular verbs in Simple Present and Simple Past:<br/><br/>Examples: <br> <span class=\"italic\">That's kind of gross, <span class=\"underline\">don't you think?</span></span> <br /><span class=\"italic\"><span class=\"underline\">Didn't people wear</span> bell bottoms back then?</span>", "type": "text"}, {"content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">  Negative auxiliary   </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">  Subject  </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">   Main Verb   </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Don't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Didn't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"people\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"wear\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Wouldn't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"it\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"be\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "Didn't people wear bell bottoms back then?", "type": "example"}, {"content": "That's kind of gross, don't you think?", "type": "example"}, {"content": "Wouldn't it be fun to drive around in one of those?", "type": "example"}, {"content": " Wasn't that huge outdoor concert in the seventies?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "pumped ", "type": "name"}, {"content": "enthusiastic about something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You must be pumped for your dad's birthday party. ", "type": "example"}, {"content": "engenn8le13ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when talking about clothing from the seventies.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "bell bottoms ", "type": "name"}, {"content": "trousers that flare from the knee with very wide bottoms; popular in the 1970s", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Didn't people wear bell bottoms back then?", "type": "example"}, {"content": "engenn8le13ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "breeze into", "type": "name"}, {"content": "to move in a casual and carefree manner", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I want to breeze into the party wearing funky patterns.", "type": "example"}, {"content": "engenn8le13ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "wide lapel ", "type": "name"}, {"content": "a very wide jacket front part that folds back against the breast ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: They had platform shoes, wide lapels and everything was polyester!", "type": "example"}, {"content": "engenn8le13ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "gross ", "type": "name"}, {"content": "inspiring feelings of strong dislike and disgust", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: That's kind of gross, don't you think?", "type": "example"}, {"content": "engenn8le13ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "funky ", "type": "name"}, {"content": "odd or unconventional", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I want to wear funky patterns.", "type": "example"}, {"content": "engenn8le13ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "psychedelic ", "type": "name"}, {"content": "a '60s style of experimental, drug-related rock music", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You can listen to psychedelic music.", "type": "example"}, {"content": "engenn8le13ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "disco ", "type": "name"}, {"content": "a style of '70s pop music for dancing at clubs ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: And you can dance disco! ", "type": "example"}, {"content": "engenn8le13ob03aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think of a theme for a costume party (e.g. 1970s, famous actors, famous people from history).", "type": "text"}, {"content": "Explain why you have chosen that theme. Research the names of some of the items of clothing that people might wear to the party and make a list.", "type": "text"}, {"content": "Encourage a friend to come. (Use a negative question.)", "type": "text"}, {"content": "Tell the friend what he or she might wear.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about a theme for a costume party.", "type": "text"}, {"content": "I research new clothing vocabulary that goes with the theme.", "type": "text"}, {"content": "I ask a negative question.", "type": "text"}, {"content": "I explain to my friend what he or she might wear to the party.", "type": "text"}]}]}